---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CTAForm from '../../components/CTAForm.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<ServiceLayout service={service}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-ink-950 text-flame-400">
      <Icon name={service.icon} class="h-7 w-7" />
    </div>
    <h1 class="mt-6 text-3xl font-bold text-ink-950">{service.title}</h1>
    <p class="mt-4 text-lg text-ink-900/70">{service.shortDescription}</p>
    <div class="mt-8 space-y-4 leading-relaxed text-ink-900/80">
      {service.description.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      service.faqs.length > 0 && (
        <div class="mt-12">
          <h2 class="text-2xl font-bold text-ink-950">Sıkça Sorulan Sorular</h2>
          <div class="mt-4 space-y-4">
            {service.faqs.map((faq) => (
              <details class="rounded-lg border border-ink-950/10 bg-white p-4">
                <summary class="cursor-pointer font-semibold text-ink-950">{faq.question}</summary>
                <p class="mt-2 text-sm text-ink-900/70">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <section class="bg-ivory-100 py-16">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="text-2xl font-bold text-ink-950">Teklif Alın</h2>
      <div class="mt-6">
        <CTAForm />
      </div>
    </div>
  </section>
</ServiceLayout>
