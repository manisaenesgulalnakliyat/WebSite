---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Hizmetlerimiz"
  description="Evden eve nakliyat, asansörlü nakliyat, ofis taşımacılığı, şehirlerarası nakliyat ve ambalaj/paketleme hizmetlerimiz."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-950">Hizmetlerimiz</h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.slug}`}
            class="group rounded-2xl border border-ink-950/10 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-gold-500/60 hover:shadow-lg"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-950 text-flame-400 transition group-hover:bg-flame-500 group-hover:text-ink-950">
              <Icon name={service.icon} class="h-6 w-6" />
            </div>
            <h2 class="mt-4 font-semibold text-ink-950">{service.title}</h2>
            <p class="mt-2 text-sm text-ink-900/70">{service.shortDescription}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
