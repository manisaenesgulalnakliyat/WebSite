---
import SEO from '../components/SEO.astro';
import CTAForm from '../components/CTAForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Logo from '../components/Logo.astro';
import UiIcon from '../components/UiIcon.astro';
import { business } from '../data/business';
import '../styles/global.css';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <SEO
      title="Ücretsiz Nakliyat Teklifi Al"
      description={`${business.name} ile ücretsiz nakliyat teklifi alın. ${business.phone}`}
    />
  </head>
  <body class="min-h-screen bg-ivory-50 font-sans text-ink-950">
    <header class="border-b border-ink-950/10 bg-white py-4">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4">
        <Logo variant="light" />
        <a
          href={`tel:${business.phone.replace(/\s/g, '')}`}
          class="flex items-center gap-1.5 text-sm font-semibold text-flame-600"
        >
          <UiIcon name="phone" class="h-4 w-4" />
          {business.phone}
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-8 text-white sm:p-10">
          <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-flame-500/20 blur-3xl">
          </div>

          <span
            class="relative inline-block rounded-full border border-flame-400/40 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-flame-300"
          >
            Ücretsiz Teklif
          </span>
          <h1 class="relative mt-5 text-3xl font-bold sm:text-4xl">Ücretsiz Nakliyat Teklifi Alın</h1>
          <p class="relative mt-4 text-ivory-100/80">
            Formu doldurun, ekibimiz WhatsApp üzerinden hemen size dönsün. Sigortalı ve güvenilir taşımacılık.
          </p>

          <ul class="relative mt-8 space-y-3 text-sm">
            {
              ['Sigortalı Taşımacılık', 'Profesyonel Ekip', 'Şeffaf Fiyatlandırma'].map((item) => (
                <li class="flex items-center gap-3">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-flame-500/20 text-flame-400">
                    <UiIcon name="check" class="h-4 w-4" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>

          <a
            href={`tel:${business.phone.replace(/\s/g, '')}`}
            class="relative mt-8 flex w-fit items-center gap-2 rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            <UiIcon name="phone" class="h-4 w-4 text-flame-400" />
            Hemen Ara: {business.phone}
          </a>
        </div>

        <div>
          <CTAForm />
        </div>
      </div>
    </main>

    <WhatsAppButton message="Merhaba, teklif al sayfasından yazıyorum." />
  </body>
</html>
