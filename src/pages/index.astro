---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Icon from '../components/Icon.astro';
import UiIcon from '../components/UiIcon.astro';
import Slider from '../components/Slider.astro';
import { services } from '../data/services';
import { cities } from '../data/cities';
import { business } from '../data/business';
---

<BaseLayout
  title="Manisa'da Premium Evden Eve Nakliyat"
  description={`${business.name} ile Manisa ve tüm ilçelerinde evden eve nakliyat, ofis taşımacılığı ve asansörlü nakliyat. ${business.areaServed.join(', ')} bölgelerinde sigortalı ve güvenilir taşımacılık.`}
>
  <section class="relative overflow-hidden bg-ink-950 py-10 text-white sm:py-12 lg:py-14">
    <div
      class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-flame-500/20 blur-3xl"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-flame-500/10 blur-3xl"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 text-center">
      <span
        class="inline-block rounded-full border border-flame-400/40 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-flame-300"
      >
        Manisa'nın Güvenilir Nakliyat Firması
      </span>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl lg:text-5xl">
        Değerli Eşyalarınız İçin <span class="text-flame-400">Ayrıcalıklı</span> Bir Taşıma Deneyimi
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-base text-ivory-100/80 sm:text-lg">
        {business.areaServed.join(', ')} başta olmak üzere Manisa genelinde evden eve nakliyat, ofis
        taşımacılığı ve asansörlü nakliyat hizmeti veriyoruz.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/teklif-al"
          class="flex items-center gap-2 rounded-full bg-flame-500 px-8 py-3 font-semibold text-ink-950 transition hover:bg-flame-400"
        >
          Ücretsiz Keşif ve Teklif Al
          <UiIcon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={`tel:${business.phone.replace(/\s/g, '')}`}
          class="flex items-center gap-2 rounded-full border border-white/25 px-8 py-3 font-semibold text-white transition hover:bg-white/10"
        >
          <UiIcon name="phone" class="h-4 w-4 text-flame-400" />
          Hemen Ara: {business.phone}
        </a>
      </div>

      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 border-t border-white/10 pt-5 text-sm text-ivory-100/70">
        <div>
          <p class="font-display text-xl text-flame-400 sm:text-2xl">Sigortalı</p>
          <p class="mt-1">Taşımacılık Güvencesi</p>
        </div>
        <div>
          <p class="font-display text-xl text-flame-400 sm:text-2xl">Ücretsiz</p>
          <p class="mt-1">Keşif ve Fiyat Teklifi</p>
        </div>
        <div>
          <p class="font-display text-xl text-flame-400 sm:text-2xl">7/24</p>
          <p class="mt-1">WhatsApp Destek</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-ink-950">Hizmetlerimiz</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-900/70">
        İhtiyacınıza uygun, uçtan uca nakliyat ve taşımacılık çözümleri.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.slug}`}
            class="group rounded-2xl border border-ink-950/10 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-gold-500/60 hover:shadow-lg"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-950 text-flame-400 transition group-hover:bg-flame-500 group-hover:text-ink-950">
              <Icon name={service.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-4 font-semibold text-ink-950">{service.title}</h3>
            <p class="mt-2 text-sm text-ink-900/70">{service.shortDescription}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink-950 py-10 text-white sm:py-12">
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-flame-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-flame-500/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-6xl px-4">
      <div class="mx-auto max-w-xl text-center">
        <span class="inline-block rounded-full border border-flame-400/40 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-flame-300">
          Sahadan Kareler
        </span>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">İşimizi Nasıl Yapıyoruz?</h2>
        <p class="mt-3 text-ivory-100/80">
          Manisa'nın her noktasında, her eşyaya aynı özen ve profesyonellikle yaklaşıyoruz.
        </p>
      </div>

      <div class="mt-6">
        <Slider />
      </div>
    </div>
  </section>

  <section class="bg-ivory-100 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl font-bold text-ink-950">Hizmet Bölgelerimiz</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          cities.map((city) => (
            <a
              href={`/bolgeler/${city.slug}`}
              class="rounded-full border border-ink-950/15 bg-white px-4 py-2 text-sm font-medium text-ink-900 hover:border-flame-400 hover:text-flame-600"
            >
              {city.name} Nakliyat
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-ink-950">Müşterilerimiz Ne Diyor?</h2>
    <div class="mt-6">
      <GoogleReviews />
    </div>
    <a href="/yorumlar" class="mt-6 inline-block text-sm font-semibold text-flame-600 hover:underline">
      Tüm yorumları gör →
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-950">Konumumuz</h2>
    <div class="mt-6">
      <MapEmbed />
    </div>
  </section>
</BaseLayout>
