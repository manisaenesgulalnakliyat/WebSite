---
import CityLayout from '../../layouts/CityLayout.astro';
import CTAForm from '../../components/CTAForm.astro';
import Icon from '../../components/Icon.astro';
import { cities } from '../../data/cities';
import { services } from '../../data/services';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
---

<CityLayout city={city}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-950">{city.name} Nakliyat Hizmetleri</h1>
    <p class="mt-4 text-lg text-ink-900/70">{city.intro}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      {
        city.highlights.map((highlight) => (
          <span class="rounded-full bg-ink-950 px-3 py-1 text-sm text-flame-300">{highlight}</span>
        ))
      }
    </div>

    <h2 class="mt-10 text-xl font-bold text-ink-950">Hizmetlerimiz</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.slug}`}
            class="flex items-start gap-3 rounded-xl border border-ink-950/10 bg-white p-5 hover:border-gold-500/60"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-ink-950 text-flame-400">
              <Icon name={service.icon} class="h-5 w-5" />
            </div>
            <div>
              <h3 class="font-semibold text-ink-950">
                {service.title} · {city.name}
              </h3>
              <p class="mt-1 text-sm text-ink-900/70">{service.shortDescription}</p>
            </div>
          </a>
        ))
      }
    </div>

  </section>

  <section class="bg-ivory-100 py-16">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="text-2xl font-bold text-ink-950">{city.name} İçin Teklif Alın</h2>
      <div class="mt-6">
        <CTAForm />
      </div>
    </div>
  </section>
</CityLayout>
