---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cities } from '../../data/cities';
---

<BaseLayout title="Hizmet Bölgelerimiz" description="Manisa genelinde nakliyat hizmeti verdiğimiz ilçeler.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-950">Hizmet Bölgelerimiz</h1>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cities.map((city) => (
          <a
            href={`/bolgeler/${city.slug}`}
            class="rounded-2xl border border-ink-950/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-gold-500/60 hover:shadow-lg"
          >
            <h2 class="font-semibold text-ink-950">{city.name} Nakliyat</h2>
            <p class="mt-2 text-sm text-ink-900/70">{city.highlights.join(' · ')}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
