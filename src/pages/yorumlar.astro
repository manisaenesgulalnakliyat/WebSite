---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { getGoogleReviews } from '../lib/googlePlaces';
import { business } from '../data/business';

const { reviews, rating, totalReviews } = await getGoogleReviews();

const jsonLd =
  totalReviews > 1
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'MovingCompany',
          name: business.name,
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: rating.toFixed(1),
            reviewCount: totalReviews,
          },
          review: reviews.slice(0, 10).map((r) => ({
            '@type': 'Review',
            author: { '@type': 'Person', name: r.author_name },
            reviewRating: { '@type': 'Rating', ratingValue: r.rating },
            reviewBody: r.text,
          })),
        },
      ]
    : [];
---

<BaseLayout
  title="Müşteri Yorumları"
  description="Müşterilerimizin nakliyat hizmetimiz hakkındaki gerçek Google yorumları."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-950">Müşteri Yorumları</h1>

    <div class="mt-10">
      <GoogleReviews />
    </div>
  </section>
</BaseLayout>
