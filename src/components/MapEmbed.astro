---
import { business } from '../data/business';
import UiIcon from './UiIcon.astro';

interface Props {
  src?: string;
  title?: string;
  heightClass?: string;
}

const {
  src = business.googleMapsEmbedSrc,
  title = `${business.name} Konum Haritası`,
  heightClass = 'h-80',
} = Astro.props;
---

<div
  class={`map-embed relative w-full overflow-hidden rounded-2xl border border-ink-950/10 bg-ivory-100 shadow-sm ${heightClass}`}
  data-src={src}
  data-title={title}
>
  <div class="flex h-full w-full flex-col items-center justify-center gap-3 px-4 text-center">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-ink-950 text-flame-400">
      <UiIcon name="pin" class="h-6 w-6" />
    </span>
    <p class="text-sm text-ink-900/70">{business.address.streetAddress}, {business.address.addressLocality}</p>
    <button
      type="button"
      class="map-embed-trigger rounded-full bg-flame-500 px-5 py-2 text-sm font-semibold text-ink-950 transition hover:bg-flame-400"
    >
      Haritayı Göster
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.map-embed').forEach((container) => {
    const trigger = container.querySelector<HTMLButtonElement>('.map-embed-trigger');

    trigger?.addEventListener('click', () => {
      const src = container.dataset.src ?? '';
      const title = container.dataset.title ?? 'Harita';

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = title;
      iframe.width = '100%';
      iframe.height = '100%';
      iframe.style.border = '0';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';

      container.replaceChildren(iframe);
    });
  });
</script>
