---
import Logo from './Logo.astro';
import UiIcon from './UiIcon.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { cities } from '../data/cities';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950 text-ivory-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 text-sm sm:grid-cols-2 md:grid-cols-4">
    <div>
      <Logo variant="dark" />
      <p class="mt-4 text-ivory-100/70">{business.address.streetAddress}</p>
      <p class="text-ivory-100/70">{business.address.addressLocality} {business.address.postalCode}</p>
      <p class="mt-3">
        <a href={`tel:${business.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 text-flame-400 hover:text-flame-300">
          <UiIcon name="phone" class="h-4 w-4" />
          {business.phone}
        </a>
      </p>
      <p>
        <a href={`mailto:${business.email}`} class="text-ivory-100/70 hover:text-flame-300">
          {business.email}
        </a>
      </p>
    </div>

    <div>
      <p class="font-semibold text-white">Hizmetler</p>
      <ul class="mt-3 space-y-1.5 text-ivory-100/70">
        {
          services.map((service) => (
            <li>
              <a href={`/hizmetler/${service.slug}`} class="hover:text-flame-300">
                {service.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Bölgeler</p>
      <ul class="mt-3 space-y-1.5 text-ivory-100/70">
        {
          cities.map((city) => (
            <li>
              <a href={`/bolgeler/${city.slug}`} class="hover:text-flame-300">
                {city.name} Nakliyat
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Kurumsal</p>
      <ul class="mt-3 space-y-1.5 text-ivory-100/70">
        <li><a href="/hakkimizda" class="hover:text-flame-300">Hakkımızda</a></li>
        <li><a href="/iletisim" class="hover:text-flame-300">İletişim</a></li>
        <li><a href="/yorumlar" class="hover:text-flame-300">Yorumlar</a></li>
        <li><a href="/teklif-al" class="hover:text-flame-300">Ücretsiz Teklif Al</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 py-4 text-center text-xs text-ivory-100/70">
    © {year} {business.name}. Tüm hakları saklıdır.
  </div>
</footer>
