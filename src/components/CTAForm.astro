---
import UiIcon from './UiIcon.astro';
import { business } from '../data/business';
---

<form id="cta-form" class="rounded-3xl border border-ink-950/10 bg-ivory-100 p-6 shadow-lg sm:p-7">
  <div class="mb-6 flex items-center gap-3 border-b border-ink-950/10 pb-5">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flame-500/10 text-flame-600">
      <UiIcon name="whatsapp" class="h-5 w-5" />
    </span>
    <div>
      <p class="font-semibold text-ink-950">Hızlı Teklif Formu</p>
      <p class="text-xs text-ink-900/60">Bilgileriniz yalnızca size dönüş yapmak için kullanılır.</p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="cta-name" class="block text-sm font-medium text-ink-900">Ad Soyad</label>
      <div class="relative mt-1">
        <UiIcon name="user" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-950/40" />
        <input
          id="cta-name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-ink-950/15 bg-ivory-50 py-2 pl-9 pr-3 text-sm transition focus:border-flame-500 focus:outline-none focus:ring-2 focus:ring-flame-500/20"
        />
      </div>
    </div>

    <div>
      <label for="cta-phone" class="block text-sm font-medium text-ink-900">Telefon</label>
      <div class="relative mt-1">
        <UiIcon name="phone" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-950/40" />
        <input
          id="cta-phone"
          name="phone"
          type="tel"
          required
          class="w-full rounded-lg border border-ink-950/15 bg-ivory-50 py-2 pl-9 pr-3 text-sm transition focus:border-flame-500 focus:outline-none focus:ring-2 focus:ring-flame-500/20"
        />
      </div>
    </div>

    <div>
      <label for="cta-from" class="block text-sm font-medium text-ink-900">Nereden</label>
      <div class="relative mt-1">
        <UiIcon name="pin" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-950/40" />
        <input
          id="cta-from"
          name="from"
          type="text"
          required
          class="w-full rounded-lg border border-ink-950/15 bg-ivory-50 py-2 pl-9 pr-3 text-sm transition focus:border-flame-500 focus:outline-none focus:ring-2 focus:ring-flame-500/20"
        />
      </div>
    </div>

    <div>
      <label for="cta-to" class="block text-sm font-medium text-ink-900">Nereye</label>
      <div class="relative mt-1">
        <UiIcon name="pin" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-950/40" />
        <input
          id="cta-to"
          name="to"
          type="text"
          required
          class="w-full rounded-lg border border-ink-950/15 bg-ivory-50 py-2 pl-9 pr-3 text-sm transition focus:border-flame-500 focus:outline-none focus:ring-2 focus:ring-flame-500/20"
        />
      </div>
    </div>
  </div>

  <div class="mt-4">
    <label for="cta-note" class="block text-sm font-medium text-ink-900">Notunuz (opsiyonel)</label>
    <div class="relative mt-1">
      <UiIcon name="note" class="pointer-events-none absolute left-3 top-3 h-4 w-4 text-ink-950/40" />
      <textarea
        id="cta-note"
        name="note"
        rows="3"
        class="w-full rounded-lg border border-ink-950/15 bg-ivory-50 py-2 pl-9 pr-3 text-sm transition focus:border-flame-500 focus:outline-none focus:ring-2 focus:ring-flame-500/20"
      ></textarea>
    </div>
  </div>

  <button
    type="submit"
    class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-4 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-green-700"
  >
    <UiIcon name="whatsapp" class="h-5 w-5" />
    WhatsApp ile Teklif İste
  </button>
</form>

<script define:vars={{ whatsappNumber: business.whatsappNumber }}>
  const form = document.getElementById('cta-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);

    const message = [
      'Merhaba, taşımacılık teklifi almak istiyorum.',
      `Ad Soyad: ${data.get('name')}`,
      `Telefon: ${data.get('phone')}`,
      `Nereden: ${data.get('from')}`,
      `Nereye: ${data.get('to')}`,
      data.get('note') ? `Not: ${data.get('note')}` : null,
    ]
      .filter(Boolean)
      .join('\n');

    window.gtag?.('event', 'quote_request', { event_category: 'lead' });
    window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
  });
</script>
