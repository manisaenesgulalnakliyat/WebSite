---
import { getGoogleReviews } from '../lib/googlePlaces';

const { reviews, rating, totalReviews } = await getGoogleReviews();
---

{
  totalReviews > 1 && (
    <section class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-lg font-semibold text-ink-950">Google Değerlendirmesi:</span>
        <span class="text-lg font-bold text-flame-600">{rating.toFixed(1)} / 5</span>
        <span class="text-sm text-ink-900/60">({totalReviews} değerlendirme)</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {reviews.map((review) => (
          <article class="rounded-xl border border-ink-950/10 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <p class="font-semibold text-ink-950">{review.author_name}</p>
              <div class="flex text-flame-500">
                {'★'.repeat(review.rating)}
                {'☆'.repeat(5 - review.rating)}
              </div>
            </div>
            <p class="mt-2 text-sm text-ink-900/70">{review.text}</p>
            <p class="mt-3 text-xs text-ink-900/70">{review.relative_time_description}</p>
          </article>
        ))}
      </div>
    </section>
  )
}
