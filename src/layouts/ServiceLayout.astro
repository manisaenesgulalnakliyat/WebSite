---
import BaseLayout from './BaseLayout.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: new URL('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Hizmetler', item: new URL('/hizmetler', Astro.site) },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.title,
      item: new URL(`/hizmetler/${service.slug}`, Astro.site),
    },
  ],
};

const faqJsonLd = service.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: service.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;

const jsonLd = [breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<BaseLayout title={service.title} description={service.shortDescription} jsonLd={jsonLd}>
  <slot />
</BaseLayout>
